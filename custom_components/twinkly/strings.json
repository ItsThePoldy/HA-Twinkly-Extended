{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]"
    },
    "flow_title": "{name}",
    "step": {
      "discovery_confirm": {
        "description": "Do you want to set up {name} - {model} ({host})?"
      },
      "user": {
        "data": {
          "host": "[%key:common::config_flow::data::host%]"
        },
        "data_description": {
          "host": "Hostname or IP address of your Twinkly device."
        }
      }
    }
  },
  "entity": {
    "select": {
      "animation": {
        "name": "Animation"
      },
      "mode": {
        "name": "Mode",
        "state": {
          "color": "Color",
          "demo": "Demo (effects in turn)",
          "effect": "Effect",
          "movie": "Uploaded effect",
          "off": "[%key:common::state::off%]",
          "playlist": "Playlist",
          "rt": "Real time (live stream from app or music)"
        }
      },
      "library": {
        "name": "Upload from library"
      },
      "delete_movie": {
        "name": "Delete movie"
      }
    },
    "switch": {
      "app_mode": {
        "name": "App mode",
        "state_attributes": {
          "reason": {
            "name": "Reason",
            "state": {
              "app_mode": "App mode",
              "other_client": "Another client is using the device"
            }
          },
          "until": {
            "name": "Paused until"
          }
        }
      }
    },
    "button": {
      "play_all": {
        "name": "Play all animations in turn"
      }
    },
    "number": {
      "playlist_duration": {
        "name": "Duration per animation"
      }
    }
